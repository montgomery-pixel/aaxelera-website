# Copy to .env.local for local development, and add the same names in Vercel
# (Project > Settings > Environment Variables). All values are public by design.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Pixel ID (numbers only), e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Google tag ID: a Google Ads ID (AW-XXXXXXXXXX) or GA4 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Optional Google Ads conversion "send_to" value, e.g. AW-XXXXXXXXXX/AbCdEfGhIjK
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
